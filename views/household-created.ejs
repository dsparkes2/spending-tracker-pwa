<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Household Created</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

<div class="container mt-5">

    <h1 class="mb-4">Household Created!</h1>

    <p>
        Your household budget has been created successfully.
    </p>

    <p>
        Give this code to your spouse or partner so they can join your household:
    </p>

    <div class="alert alert-primary fs-2 text-center">
        <strong><%= household.code %></strong>
    </div>

    <p>
        Household:
        <strong><%= household.name %></strong>
    </p>

    <a href="/expenses" class="btn btn-primary">
        Go to Expenses
    </a>

</div>

</body>
</html>
