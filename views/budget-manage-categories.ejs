   <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Budget Categories</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

<div class="container mt-5">

    <h1>
        Manage Your
        <%= new Date(year, month - 1).toLocaleString('default', { month: 'long' }) %>
        <%= year %> Categories
    </h1>

    <p class="mt-4">
        Add, remove, or change the spending limits for your categories.
    </p>

    <% if (categories.length === 0) { %>

        <div class="alert alert-info mt-4">
            You don't have any budget categories set up yet.
        </div>

    <% } else { %>

        <div class="mt-4">

            <% categories.forEach(category => { %>

                <div class="card mb-3">
                    <div class="card-body">

                        <h2 class="h5">
                            <%= category.name %>
                        </h2>

                        <p class="mb-0">
                            Monthly Limit:
                            <strong>
                                $<%= Number(category.monthlyLimit).toFixed(2) %>
                            </strong>
                        </p>

                    </div>
                </div>

            <% }); %>

        </div>

    <% } %>

    <a href="/budget" class="btn btn-secondary mt-3">
        Back to Budget
    </a>

</div>

</body>
</html>
