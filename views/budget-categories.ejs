<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Budget Categories</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

<div class="container mt-5">

    <h1>
        Set Up Your
        <%= new Date(year, month - 1).toLocaleString('default', { month: 'long' }) %>
        <%= year %> Categories
    </h1>

    <p class="mt-4">
        Choose the categories you want to use this month and set a monthly spending limit.
    </p>

    <form method="POST" action="/budget/categories" class="mt-4">

        <div class="mb-4">
    <label class="form-label">
        Total Monthly Spending Limit
    </label>

    <input
        type="number"
        class="form-control"
        name="monthlyLimit"
        placeholder="Example: 3500"
        min="0"
        step="0.01"
        required
    >
</div>
        <div class="mb-3">
            <label class="form-label">Groceries</label>
            <input
                type="number"
                class="form-control"
                name="groceries"
                placeholder="Monthly limit"
                min="0"
                step="0.01"
            >
        </div>

        <div class="mb-3">
            <label class="form-label">Gas</label>
            <input
                type="number"
                class="form-control"
                name="gas"
                placeholder="Monthly limit"
                min="0"
                step="0.01"
            >
        </div>

        <div class="mb-3">
            <label class="form-label">Utilities</label>
            <input
                type="number"
                class="form-control"
                name="utilities"
                placeholder="Monthly limit"
                min="0"
                step="0.01"
            >
        </div>

        <div class="mb-3">
            <label class="form-label">Dining Out</label>
            <input
                type="number"
                class="form-control"
                name="diningOut"
                placeholder="Monthly limit"
                min="0"
                step="0.01"
            >
        </div>

        <div class="mb-3">
            <label class="form-label">Entertainment</label>
            <input
                type="number"
                class="form-control"
                name="entertainment"
                placeholder="Monthly limit"
                min="0"
                step="0.01"
            >
        </div>

        <button type="submit" class="btn btn-primary mt-3">
            Save Budget Categories
        </button>

    </form>

</div>

</body>
</html>

