<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Expenses</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet">
</head>

<body>

<div class="container py-4">

    <h2 class="text-center mb-4">Expenses</h2>

    <div class="text-end mb-3">
        <a href="/expenses/add" class="btn btn-primary">
            Add New Expense
        </a>
    </div>

    <% if (expenses && expenses.length > 0) { %>

        <% expenses.forEach(exp => { %>

            <div class="card shadow-sm mb-3">
                <div class="card-body">

                    <h5 class="card-title">
                        $<%= Number(exp.amount || 0).toFixed(2) %>
                    </h5>

                    <p class="mb-1">
                        <strong>Category:</strong>
                        <%= exp.budgetCategory ? exp.budgetCategory.name : "Not assigned" %>
                    </p>

                    <p class="mb-1">
                        <strong>Budget:</strong>
                        <% if (exp.budget) { %>
                            <%= exp.budget.month %>/<%= exp.budget.year %>
                        <% } else { %>
                            Not assigned
                        <% } %>
                    </p>

                    <p class="mb-1">
                        <strong>Entered by:</strong>
                        <%= exp.user ? exp.user.username : "Unknown" %>
                    </p>

                    <% if (exp.notes) { %>
                        <p class="mb-1">
                            <strong>Notes:</strong>
                            <%= exp.notes %>
                        </p>
                    <% } %>

                    <p class="mb-3">
                        <strong>Date:</strong>
                        <%= exp.date ? new Date(exp.date).toDateString() : "No date" %>
                    </p>

                    <% if (exp.receiptImage) { %>

                        <img
                            src="/uploads/<%= exp.receiptImage %>"
                            class="img-fluid rounded"
                            style="max-width:250px;"
                            alt="Receipt">

                    <% } %>

                </div>
            </div>

        <% }) %>

    <% } else { %>

        <div class="alert alert-info">
            No expenses found.
        </div>

    <% } %>

</div>

</body>
</html>
