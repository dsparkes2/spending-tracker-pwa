<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Household Setup</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>
    <div class="container py-5">
        <div class="text-center">
            <h1 class="mb-4">Let's Set Up Your Household Budget</h1>

            <p class="fs-4 mb-5">
                What would you like to do?
            </p>

            <div class="d-grid gap-4 col-12 col-md-8 mx-auto">

                <a href="/household/create" class="btn btn-primary btn-lg py-4">
                    🏠<br>
                    <span class="fs-3">Start a New Household Budget</span>
                </a>

                <a href="/household/join" class="btn btn-secondary btn-lg py-4">
                    👥<br>
                    <span class="fs-3">Join an Existing Household Budget</span>
                </a>

            </div>
        </div>
    </div>
</body>
</html>
