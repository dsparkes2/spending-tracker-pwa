<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set Up Your Monthly Budget</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

<div class="container mt-5">

    <h1>
        Set Up Your
        <%= new Date(year, month - 1).toLocaleString('default', { month: 'long' }) %>
        <%= year %> Budget
    </h1>

    <p class="mt-4">
        Let's set up your household budget for this month.
    </p>

    <p>
        You will be able to choose your categories and set a spending limit
        for each category.
    </p>

    <button class="btn btn-primary mt-3">
        Continue
    <a href="/budget/categories" class="btn btn-primary mt-3">
    Continue
</a>

</div>

</body>
</html>
