<!DOCTYPE html>

<html lang="en"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Create Account - Spending Tracker</title>

<link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
>

<style>
    body {
        background-color: #f5f7fa;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .register-card {
        width: 100%;
        max-width: 450px;
        padding: 35px;
        border-radius: 20px;
        background: white;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .app-title {
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 10px;
    }

    .app-subtitle {
        text-align: center;
        color: #666;
        font-size: 1.1rem;
        margin-bottom: 30px;
    }

    .form-label {
        font-size: 1.1rem;
        font-weight: 600;
    }

    .form-control {
        font-size: 1.1rem;
        padding: 14px;
        border-radius: 10px;
    }

    .register-button {
        width: 100%;
        padding: 14px;
        font-size: 1.2rem;
        font-weight: 600;
        border-radius: 10px;
    }

    .login-link {
        text-align: center;
        margin-top: 25px;
        font-size: 1.05rem;
    }
</style>

</head>

<body>

<div class="register-card">

    <div class="app-title">
        Spending Tracker
    </div>

    <div class="app-subtitle">
        Create your account to start tracking your spending.
    </div>

    <form action="/auth/register" method="POST">

        <div class="mb-3">
            <label for="username" class="form-label">
                Username
            </label>

            <input
                type="text"
                class="form-control"
                id="username"
                name="username"
                placeholder="Choose a username"
                required
                autocomplete="username"
            >
        </div>

        <div class="mb-4">
            <label for="password" class="form-label">
                Password
            </label>

            <input
                type="password"
                class="form-control"
                id="password"
                name="password"
                placeholder="Create a password"
                required
                autocomplete="new-password"
            >
        </div>

        <button type="submit" class="btn btn-primary register-button">
            Create Account
        </button>

    </form>

    <div class="login-link">
        Already have an account?
        <a href="/auth/login">Log in</a>
    </div>

</div>

</body> </html>
