<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monthly Budget</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

<div class="container mt-5">

    <h1><%= new Date(year, month - 1).toLocaleString('default', { month: 'long' }) %> <%= year %> Budget</h1>

    <% if (!budget) { %>

        <p class="mt-4">
            You don't have a budget set up for this month yet.
        </p>

        <a href="/budget/new" class="btn btn-primary mt-2">
            Start This Month's Budget
        </a>
<% } else { %>
    <p class="mt-4">
        Your budget is already set up for this month.
    </p>

    <div class="card mt-4">
        <div class="card-body">
            <h2 class="card-title">Monthly Spending Limit</h2>

            <p class="fs-3">
                $<%= Number(budget.monthlyLimit || 0).toFixed(2) %>
            </p>
        </div>
    </div>

<% } %>

</div>

</body>
</html>
