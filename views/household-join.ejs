<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Join an Existing Household Budget</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

<div class="container mt-5">

    <h1 class="mb-4">Join an Existing Household Budget</h1>

    <p>
        Enter the household code provided by your spouse or partner.
    </p>

    <form method="POST" action="/household/join">

        <div class="mb-3">
            <label for="householdId" class="form-label">
                Household Code
            </label>

            <input
                type="text"
                class="form-control"
                id="householdId"
                name="householdId"
                placeholder="Enter household code"
                required
            >
        </div>

        <button type="submit" class="btn btn-primary">
            Join Household
        </button>

    </form>

</div>

</body>
</html>
