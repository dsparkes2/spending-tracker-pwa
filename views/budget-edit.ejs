<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Monthly Budget</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

<div class="container mt-5">

    <h1>
        Change Your
        <%= new Date(year, month - 1).toLocaleString('default', { month: 'long' }) %>
        <%= year %> Budget
    </h1>

    <p class="mt-4">
        Your current monthly spending limit is:
        <strong>$<%= Number(budget.monthlyLimit || 0).toFixed(2) %></strong>
    </p>

    <form method="POST" action="/budget/edit" class="mt-4">

        <div class="mb-3">
            <label class="form-label">
                New Monthly Spending Limit
            </label>

            <input
                type="number"
                class="form-control"
                name="monthlyLimit"
                value="<%= budget.monthlyLimit || '' %>"
                min="0"
                step="0.01"
                required
            >
        </div>

        <button type="submit" class="btn btn-primary">
            Save New Limit
        </button>

        <a href="/budget" class="btn btn-secondary ms-2">
            Cancel
        </a>

    </form>

</div>

</body>
</html>
