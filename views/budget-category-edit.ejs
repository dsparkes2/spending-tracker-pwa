<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Budget Category</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
</head>

<body>

<div class="container mt-5">

    <h1>
        Edit
        <%= category.name %>
    </h1>

    <p class="mt-4">
        <%= new Date(year, month - 1).toLocaleString('default', { month: 'long' }) %>
        <%= year %> Budget
    </p>

    <form method="POST" action="/budget/category/edit/<%= category._id %>" class="mt-4">

        <div class="mb-3">
            <label class="form-label">
                Category Name
            </label>

            <input
                type="text"
                class="form-control"
                value="<%= category.name %>"
                disabled
            >
        </div>

        <div class="mb-3">
            <label class="form-label">
                Monthly Spending Limit
            </label>

            <input
                type="number"
                class="form-control"
                name="monthlyLimit"
                value="<%= category.monthlyLimit %>"
                min="0"
                step="0.01"
                required
            >
        </div>

        <button type="submit" class="btn btn-primary">
            Save Category Limit
        </button>

        <a href="/budget/manage-categories" class="btn btn-secondary ms-2">
            Cancel
        </a>

    </form>

</div>

</body>
</html>
